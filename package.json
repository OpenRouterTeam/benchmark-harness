{
  "name": "@openrouter/bench-harness",
  "version": "0.0.0",
  "description": "Kepler, the OpenRouter TypeScript benchmark harness (inspect-ai-style primitives, Effect-based)",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "exports": {
    "./benchmarks/benchmark-config": "./src/benchmarks/benchmark-config.ts",
    "./benchmarks/benchmark-meta": "./src/benchmarks/benchmark-meta.ts",
    "./benchmarks/types": "./src/benchmarks/types.ts",
    "./benchmarks/registry": "./src/benchmarks/registry.ts",
    "./benchmarks/deep-swe/schema": "./src/benchmarks/deep-swe/schema.ts",
    "./benchmarks/search/core/config": "./src/benchmarks/search/core/config.ts",
    "./benchmarks/search/provenance": "./src/benchmarks/search/provenance.ts",
    "./benchmarks/swe-atlas/schema": "./src/benchmarks/swe-atlas/schema.ts",
    "./benchmarks/terminal-bench/schema": "./src/benchmarks/terminal-bench/schema.ts",
    "./sandbox": "./src/sandbox/session.ts",
    "./sandbox/modal": "./src/sandbox/modal.ts",
    "./sandbox/modal-schema": "./src/sandbox/modal-schema.ts",
    "./sandbox/modal-regions": "./src/sandbox/modal-regions.ts",
    "./benchmarks/harbor/sandbox": "./src/sandbox/session.ts",
    "./benchmarks/harbor/modal-sandbox": "./src/sandbox/modal.ts",
    "./benchmarks/agent-cli/schema": "./src/benchmarks/agent-cli/schema.ts",
    "./benchmarks/agent-cli/harness": "./src/benchmarks/agent-cli/harness.ts",
    "./benchmarks/agent-cli/runner": "./src/benchmarks/agent-cli/runner.ts",
    "./core": "./src/harness/core.ts",
    "./constants": "./src/harness/constants.ts",
    "./dataset": "./src/harness/dataset.ts",
    "./datasets/huggingface": "./src/datasets/huggingface.ts",
    "./model": "./src/harness/model.ts",
    "./metric": "./src/harness/metric.ts",
    "./providers/openrouter-model": "./src/providers/openrouter-model.ts",
    "./run": "./src/harness/run.ts",
    "./run-benchmark-by-id": "./src/runner/run-by-id.ts",
    "./runtime/retry": "./src/runtime/retry.ts",
    "./scorer": "./src/harness/scorer.ts",
    "./solver": "./src/harness/solver.ts",
    "./parquet": "./src/results/parquet.ts",
    "./parquet-schema": "./src/results/parquet-schema.ts",
    "./parquet-stream-writer": "./src/results/parquet-stream-writer.ts",
    "./atif-schema": "./src/results/atif-schema.ts",
    "./progress": "./src/harness/progress.ts",
    "./result-store": "./src/results/result-store.ts",
    "./internal/log": "./src/internal/log.ts",
    "./internal/effect-logger": "./src/internal/effect-logger.ts"
  },
  "scripts": {
    "bench": "bun src/cli/index.ts",
    "build": "tsgo --project tsconfig.build.json",
    "typecheck": "effect-tsgo diagnostics --project tsconfig.json && effect-tsgo diagnostics --project tsconfig.scripts.json",
    "test": "bun test",
    "lint": "bun run typecheck && bun run check",
    "format": "oxfmt src test scripts --write",
    "format:check": "oxfmt src test scripts --check",
    "check": "oxlint",
    "fix": "oxfmt src test scripts --write && oxlint --fix",
    "mirror-vgi-bench-media": "bun scripts/mirror-vgi-bench-media.ts",
    "mirror-mmmu-pro-media": "bun scripts/mirror-mmmu-pro-media.ts",
    "package-agent-runtime": "scripts/agent-runtime/package.sh"
  },
  "dependencies": {
    "@effect/platform": "0.97.2",
    "@google-cloud/storage": "8.2.0",
    "@openrouter/sdk": "1.3.19",
    "change-case": "5.4.4",
    "chrono-node": "2.10.1",
    "cli-progress": "3.12.0",
    "csv-parse": "7.0.2",
    "effect": "3.22.2",
    "hyparquet": "1.31.1",
    "hyparquet-writer": "0.16.10",
    "modal": "0.10.1",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@types/bun": "1.4.2",
    "@types/cli-progress": "3.11.6",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:@typescript/native-preview@7.0.0-dev.20260707.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "license": "Apache-2.0"
}
