    "readme": "# ecs-service\n\nACME's standard ECS Fargate service module.\n\n## Usage\n\n```hcl\nmodule \"checkout\" {\n  source  = \"app.terraform.io/acme-platform/ecs-service/aws\"\n  version = \"~> 3.2\"\n\n  name          = \"checkout\"\n  image         = \"acme/checkout:2.14.0\"\n  desired_count = 2\n}\n```\n",
    "inputs": [
     {
      "name": "name",
      "type": "string",
      "description": "Service name",
      "default": null,
      "required": true
     },
     {
      "name": "image",
      "type": "string",
      "description": "Container image",
      "default": null,
      "required": true
     },
     {
      "name": "desired_count",
      "type": "number",
      "description": "Number of tasks",
      "default": 2,
      "required": false
     },
     {
      "name": "cpu",
      "type": "number",
      "description": "Task CPU units",
      "default": 512,
      "required": false
     },
     {
      "name": "environment",
      "type": "string",
      "description": "Deployment environment",
      "default": null,
      "required": true
     }
    ],
    "outputs": [
     {
      "name": "service_name",
      "description": "ECS service name"
     },
     {
      "name": "target_group_arn",
      "description": "ALB target group ARN"
     }
    ],
    "provider_dependencies": [
     {
      "name": "aws",
      "namespace": "hashicorp",
      "source": "hashicorp/aws",
      "version": ">= 5.40"
     }
    ],
